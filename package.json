{
  "name": "interview-studio",
  "productName": "Interview Studio",
  "version": "1.5.1",
  "description": "A local-first desktop interview workspace with AI answers, screenshots and practice records.",
  "main": "src/main.cjs",
  "author": "Interview Studio",
  "license": "MIT",
  "private": true,
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "start": "node scripts/launch.cjs start",
    "build": "node scripts/launch.cjs build",
    "package": "node scripts/launch.cjs package",
    "make": "node scripts/launch.cjs make",
    "test": "node scripts/launch.cjs test",
    "format": "prettier --write src scripts tests forge.config.cjs vite.config.mjs package.json",
    "format:check": "prettier --check src scripts tests forge.config.cjs vite.config.mjs package.json"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.7.2",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "mammoth": "1.11.0",
    "pdf-parse": "2.4.5",
    "vue": "3.5.44"
  }
}
